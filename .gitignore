__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Swiss Ephemeris data files (.se1): binary, fetched on demand by
# ephe/download.sh, not committed -- see ephe/README.md.
ephe/*.se1

# Vite+React app sources (app/*/): node_modules and local Vite cache aren't
# committed. Their `npm run build` output IS committed, though, straight into
# the matching demo/ folder -- see each app's vite.config.js.
app/*/node_modules/
app/*/.vite/
node_modules/
